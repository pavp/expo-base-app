# Copy this file to .env before running the app:
#
#   cp .env.example .env
#
# WARNING: every EXPO_PUBLIC_* variable is inlined into the JavaScript bundle at
# build time. Anyone with the shipped app can read its value. Never put a secret
# behind this prefix — API keys, tokens, and credentials belong in a backend the
# app calls, never in the client.

# Base URL for the API. Points at a public fixture API used for development.
EXPO_PUBLIC_API_URL='https://jsonplaceholder.typicode.com'
