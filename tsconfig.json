{
  "extends": "@tsconfig/react-native/tsconfig.json", // replace for "expo/tsconfig.base" when auto imports has been fixed
  "compilerOptions": {
    "baseUrl": "./",
    "strict": false,
    "paths": {
      "@/*": ["./src/*"],
      "@/test/*": ["./test/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "src", "spec"],
  "exclude": ["node_modules", "**/node_modules/*"]
}
